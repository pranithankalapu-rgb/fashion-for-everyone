generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                  String    @id @default(uuid())
  name                String
  email               String?   @unique
  passwordHash        String?
  refreshToken        String?
  refreshTokenExpiry  DateTime?
  avatar              String
  photoUrl            String?
  skinTone            String    @default("Warm Golden")
  undertone           String    @default("Warm")
  hairColor           String    @default("Chestnut Brown")
  bodyShape           String    @default("Hourglass")
  measurements        Json      @default("{\"heightCm\": 170, \"chestCm\": 88, \"waistCm\": 68, \"hipsCm\": 94}")
  selectedOccasions   String[]  @default([])
  styleVibes          String[]  @default([])
  completedOnboarding Boolean   @default(true)
  role                String    @default("customer")
  approvalStatus      String    @default("Approved")
  status              String    @default("Active")
  requestedRole       String?
  rejectionReason     String?
  phone               String?
  bio                 String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
}

model ColorCombo {
  id              String      @id @default(uuid())
  occasion        String
  subType         String
  title           String
  colors          Json
  rating          Float       @default(5.0)
  votesCount      Int         @default(0)
  userVote        Int?
  trendingScore   Int         @default(0)
  exampleImageUrl String
  votes           ColorVote[]
}

model ColorVote {
  id           String     @id @default(uuid())
  colorComboId String
  userId       String
  voteType     String     @default("up")
  createdAt    DateTime   @default(now())
  colorCombo   ColorCombo @relation(fields: [colorComboId], references: [id], onDelete: Cascade)

  @@unique([colorComboId, userId])
}

model Designer {
  id              String   @id @default(uuid())
  name            String
  handle          String
  avatar          String
  bio             String
  followers       Int      @default(0)
  avgRating       Float    @default(5.0)
  totalVotes      Int      @default(0)
  badges          String[]
  verified        Boolean  @default(false)
  approvalStatus  String   @default("Approved")
  status          String   @default("Active")
  email           String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  designs         Design[]
}

model Design {
  id              String    @id @default(uuid())
  designerId      String
  designerName    String
  designerAvatar  String
  title           String
  collection      String
  imageUrl        String
  rating          Float     @default(5.0)
  votesCount      Int       @default(0)
  occasion        String
  palette         String[]
  price           Float
  inStock         Boolean   @default(true)
  approvalStatus  String    @default("Approved")
  rejectionReason String?
  status          String    @default("Active")
  createdAt       String
  submittedAt     DateTime  @default(now())
  designer        Designer? @relation(fields: [designerId], references: [id], onDelete: Cascade)
}

model RetailProduct {
  id              String       @id @default(uuid())
  title           String
  brand           String
  category        String
  price           Float
  originalPrice   Float?
  imageUrl        String
  colors          String[]
  silhouette      String
  retailer        String
  affiliateUrl    String
  similarityScore Float?
  sku             String?
  status          String?
  description     String?
  sizes           String[]
  occasion        String?
  discountPercent Float?
  stockQuantity   Int?
  storeStocks     StoreStock[]
  orderItems      OrderItem[]
}

model StoreStock {
  id            String         @id @default(uuid())
  productId     String
  storeName     String
  retailer      String
  address       String
  distanceMiles Float
  sizeStock     Json
  canReserve    Boolean        @default(true)
  product       RetailProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model OutfitLook {
  id             String   @id @default(uuid())
  creatorName    String
  creatorHandle  String
  creatorAvatar  String
  videoThumbnail String
  title          String
  likes          Int      @default(0)
  reshares       Int      @default(0)
  occasion       String
  taggedProducts Json
  userLiked      Boolean? @default(false)
  createdAt      DateTime @default(now())

  @@index([occasion])
  @@index([likes])
}

model CustomerOrder {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  date            String
  status          String      @default("Pending")
  totalAmount     Float
  currency        String      @default("$")
  shippingAddress String
  deliveryDate    String?
  trackingNumber  String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  paymentMethod   String?     @default("Credit Card")
  paymentStatus   String      @default("PAID")
  paymentIntentId String?
  paymentGateway  String      @default("MOCK")
  idempotencyKey  String?
  items           OrderItem[]
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  productId String
  title     String
  brand     String
  imageUrl  String
  price     Float
  quantity  Int            @default(1)
  size      String
  color     String?
  sku       String?
  order     CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   RetailProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model RetailerCustomer {
  id             String  @id @default(uuid())
  name           String
  email          String
  phone          String
  ordersCount    Int     @default(0)
  totalSpent     Float   @default(0)
  recentOrderDate String
  recentOrderId  String
  status         String
  avatar         String?
}

model Promotion {
  id            String  @id @default(uuid())
  code          String  @unique
  title         String
  discountType  String
  discountValue Float
  category      String?
  productId     String?
  startDate     String
  endDate       String
  usageCount    Int     @default(0)
  maxUses       Int     @default(100)
  status        String  @default("Active")
}

model StoreSettings {
  id                 String   @id @default(uuid())
  storeName          String
  logoUrl            String   @default("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=300&q=80")
  taxId              String   @default("TAX-998877")
  currency           String   @default("$")
  managerName        String
  managerEmail       String
  managerPhone       String
  address            String
  supportEmail       String   @default("support@store.com")
  supportPhone       String   @default("+1 (555) 000-0000")
  autoFulfill        Boolean  @default(false)
  lowStockThreshold  Int      @default(5)
  emailNotifications Boolean  @default(true)
  smsAlerts          Boolean  @default(true)
  weeklyReport       Boolean  @default(true)
  approvalStatus     String   @default("Approved")
  status             String   @default("Active")
  rejectionReason    String?
  businessType       String?  @default("Boutique Flagship")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Reservation {
  id            String   @id @default(uuid())
  storeId       String
  productId     String
  productTitle  String
  size          String
  customerName  String
  customerPhone String
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())
}

model AiAnalysisRequest {
  id                    String   @id @default(uuid())
  userId                String?
  photoUrl              String
  occasion              String?
  confidence            Float?
  detectedSkinTone      String?
  detectedUndertone     String?
  detectedHairColor     String?
  detectedBodyShape     String?
  estimatedMeasurements Json?
  recommendedPalette    String[]
  paletteRationale      String?
  bodyShapeAdvice       String?
  colorHarmonyScore     Float?
  fitScore              Float?
  overallMatch          Float?
  providerUsed          String   @default("rule-based")
  status                String   @default("completed")
  createdAt             DateTime @default(now())
}

model Notification {
  id            String   @id @default(uuid())
  recipientRole String   @default("retailer")
  recipientId   String?
  title         String
  message       String
  type          String   @default("info")
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model TryOnJob {
  id            String   @id @default(uuid())
  userId        String
  garmentId     String?
  userPhotoUrl  String
  garmentUrl    String?
  resultUrl     String?
  status        String   @default("PENDING")
  provider      String   @default("virtual-tryon-v1")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}
