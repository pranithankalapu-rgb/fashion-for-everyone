# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/fashion_db?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="*"

# Authentication & Admin Secrets
JWT_SECRET="fashion-secret-jwt-key-change-in-production"
REFRESH_SECRET="fashion-refresh-secret-jwt-key-change-in-production"
ADMIN_EMAIL="admin@fashionforeveryone.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adminpassword123"

# Email Delivery Provider (SMTP)
# Configure with your SMTP host (e.g., smtp.gmail.com, smtp.sendgrid.net, etc.)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey_or_username"
SMTP_PASS="your_smtp_password_or_token"
SMTP_FROM="noreply@fashionforeveryone.com"

# SMS Delivery Provider (Twilio)
# Configure with your Twilio Account SID, Auth Token, and Sender Number
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
